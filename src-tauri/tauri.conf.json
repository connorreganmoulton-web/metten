{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metten",
  "version": "0.1.0",
  "identifier": "com.metten.foundation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metten \u2014 Controlled non-trading session",
        "width": 900,
        "height": 780,
        "minWidth": 560,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
